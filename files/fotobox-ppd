#!/usr/bin/env python3
"""Passt die Gutenprint-PPD des DNP DS620 fuer AirPrint an.

Aufruf: fotobox-ppd EINGABE.ppd AUSGABE.ppd

Hintergrund: iOS unterscheidet Papiere nur nach ihren Massen. In der PPD von
Gutenprint haben mehrere Formate dieselben Masse wie 4x6 (297,6 x 460,8 pt):
die Streifenformate, die der Drucker aus einem 4x6-Feld schneidet. Ohne
Anpassung landet ein 10x15-Druck vom iPad auf dem falschen Format.

Was das Skript tut:
  - 4x6 (w288h432) bleibt, wie es ist, und wird Standard.
  - 2x6 (w144h432) bekommt die Blattlaenge 468,0 pt.
  - 3.375x6 (w243h432) bekommt die Blattlaenge 475,2 pt. Es dient als Traeger
    fuer den 5,6-cm-Streifen; den Schnitt setzt das vorgeschaltete Backend.
  - Alle anderen Formate mit den Massen von 4x6 werden entfernt.

Die Breite der druckbaren Flaeche bleibt unveraendert. Eine schmalere Flaeche
streckt der Treiber auf seine eigene Breite.
"""
import re
import sys

MARKER = "*% Fotobox-Anpassung 2"
BASE = "w288h432"
BASE_DIMENSION = (297.6, 460.8)
# Format -> neue Blattlaenge in Punkt. Die Laengen muessen sich um mehr als
# 5 pt unterscheiden, sonst ordnet CUPS Auftraege dem falschen Format zu.
KEEP = {"w144h432": 468.0, "w243h432": 475.2}
SECTIONS = ("PageSize", "PageRegion", "ImageableArea", "PaperDimension")

ENTRY = re.compile(r'^\*(?P<section>PageSize|PageRegion|ImageableArea|PaperDimension) (?P<name>[^/:\s]+)(?P<label>/[^:]*)?:\s*"(?P<value>[^"]*)"\s*$')


def numbers(text):
    return [float(item) for item in re.findall(r"-?\d+(?:\.\d+)?", text)]


def close(a, b):
    return abs(a - b) < 0.05


def mentions(line, name):
    return re.search(r"(?<![\w-])" + re.escape(name) + r"(?![\w-])", line) is not None


def patch(text):
    lines = text.split("\n")
    if any(line.strip() == MARKER for line in lines):
        return text, "schon angepasst"

    # Alle Formate mit den Massen von 4x6 finden
    same = []
    for line in lines:
        match = ENTRY.match(line)
        if match and match.group("section") == "PaperDimension":
            value = numbers(match.group("value"))
            if len(value) == 2 and close(value[0], BASE_DIMENSION[0]) and close(value[1], BASE_DIMENSION[1]):
                same.append(match.group("name"))
    if BASE not in same:
        raise SystemExit("In der PPD fehlt das Format %s mit %.1f x %.1f pt, Abbruch." % ((BASE,) + BASE_DIMENSION))
    remove = [name for name in same if name != BASE and name not in KEEP]
    missing = [name for name in KEEP if name not in same]

    out = []
    for line in lines:
        if any(mentions(line, name) for name in remove):
            continue
        match = ENTRY.match(line)
        if match and match.group("name") in KEEP and match.group("name") in same:
            length = KEEP[match.group("name")]
            shift = (length - BASE_DIMENSION[1]) / 2
            head = "*%s %s%s:\t" % (match.group("section"), match.group("name"), match.group("label") or "")
            section = match.group("section")
            if section in ("PageSize", "PageRegion"):
                line = head + '"<</PageSize[%.3f %.3f]/ImagingBBox null>>setpagedevice"' % (BASE_DIMENSION[0], length)
            elif section == "PaperDimension":
                line = head + '"%.3f %.3f"' % (BASE_DIMENSION[0], length)
            else:
                left, bottom, right, top = numbers(match.group("value"))
                line = head + '"%.3f %.3f %.3f %.3f"' % (left, bottom + shift, right, top + shift)
        elif re.match(r"^\*Default(PageSize|PageRegion|ImageableArea|PaperDimension):", line):
            line = line.split(":", 1)[0] + ": " + BASE
        out.append(line)

    # Marke hinter die erste Zeile (*PPD-Adobe) setzen
    out.insert(1, MARKER)
    note = "angepasst; entfernt: %s" % (", ".join(remove) or "nichts")
    if missing:
        note += "; nicht vorhanden: %s" % ", ".join(missing)
    return "\n".join(out), note


def main():
    if len(sys.argv) != 3:
        raise SystemExit(__doc__)
    with open(sys.argv[1], encoding="utf-8", errors="surrogateescape") as handle:
        text = handle.read()
    result, note = patch(text)
    with open(sys.argv[2], "w", encoding="utf-8", errors="surrogateescape") as handle:
        handle.write(result)
    print("PPD %s" % note)


if __name__ == "__main__":
    main()
